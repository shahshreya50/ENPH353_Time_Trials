<?xml version='1.0'?>
<robot name="robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
<xacro:property name="camera_width" value="0.02"/>
<xacro:property name="camera_length" value="0.02"/>
<xacro:property name="camera_height" value="0.01"/>
<xacro:property name="camera_mass" value="0.01"/>
<xacro:property name="chassis_height" value="0.05"/>
<xacro:property name="chassis_mass" value="19.94"/>
<xacro:property name="chassis_radius" value="0.1"/>
<xacro:property name="leg_radius"  value="0.005"/>
<xacro:property name="leg_length"  value="0.04"/>
<xacro:property name="leg_mass"    value="0.01"/>
<xacro:property name="down_cam_radius" value="0.01"/>
<xacro:property name="down_cam_height" value="0.005"/>
<xacro:property name="down_cam_mass"   value="0.01"/>
<xacro:include filename="$(find robbie)/urdf/macros.xacro"/>

<!-- Body -->
<link name='chassis'>
  <xacro:cylinder_inertial name="chassis" m="${chassis_mass}" r="${chassis_radius}" h="${chassis_height}"/>
  <collision name='chassis_collision'>
    <geometry>
      <cylinder radius="${chassis_radius}" length="${chassis_height}"/>
    </geometry>
  </collision>
  <visual name='chassis_visual'>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <cylinder radius="${chassis_radius}" length="${chassis_height}"/>
    </geometry>
  </visual>
</link>

<!-- Force Controller -->
<gazebo>
  <plugin name="chassis" filename="libgazebo_ros_force.so">
    <bodyName>chassis</bodyName>
    <topicName>/B1/cmd_force</topicName>
  </plugin>
</gazebo>
<gazebo reference="chassis">
  <enable_wind>true</enable_wind>
</gazebo>

<!-- Forward Camera -->
<link name='camera_link'>
  <xacro:box_inertial name="camera_link" m="${camera_mass}" x="${camera_width}" y="${camera_length}" z="${camera_height}"/>
  <collision name='camera_link_collision'>
    <geometry>
      <box size="${camera_length} ${camera_width} ${camera_height}"/>
    </geometry>
  </collision>
  <visual name='camera_link_visual'>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="${camera_length} ${camera_width} ${camera_height}"/>
    </geometry>
  </visual>
</link>
<joint name="camera_joint" type="fixed">
  <parent link="chassis"/>
  <child link="camera_link"/>
  <origin xyz="${chassis_radius} 0 ${chassis_height/2 - camera_height/2 - 0.0001}"/>
</joint>
<gazebo reference="camera_link">
  <sensor type="camera" name="camera1">
    <update_rate>30.0</update_rate>
    <camera name="head">
      <horizontal_fov>2.094395</horizontal_fov>
      <image>
        <width>800</width>
        <height>800</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.02</near>
        <far>300</far>
      </clip>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.007</stddev>
      </noise>
    </camera>
    <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
      <alwaysOn>true</alwaysOn>
      <updateRate>0.0</updateRate>
      <cameraName>rrbot/camera1</cameraName>
      <imageTopicName>image_raw</imageTopicName>
      <cameraInfoTopicName>camera_info</cameraInfoTopicName>
      <frameName>camera_link</frameName>
      <hackBaseline>0.07</hackBaseline>
      <distortionK1>0.0</distortionK1>
      <distortionK2>0.0</distortionK2>
      <distortionK3>0.0</distortionK3>
      <distortionT1>0.0</distortionT1>
      <distortionT2>0.0</distortionT2>
    </plugin>
  </sensor>
</gazebo>

<!-- Downward Camera -->
<link name='camera_down_link'>
  <xacro:cylinder_inertial name="camera_down_link" m="${down_cam_mass}" r="${down_cam_radius}" h="${down_cam_height}"/>
  <collision name='camera_down_link_collision'>
    <geometry>
      <cylinder radius="${down_cam_radius}" length="${down_cam_height}"/>
    </geometry>
  </collision>
  <visual name='camera_down_link_visual'>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <cylinder radius="${down_cam_radius}" length="${down_cam_height}"/>
    </geometry>
  </visual>
</link>

<joint name="camera_down_joint" type="fixed">
  <parent link="chassis"/>
  <child link="camera_down_link"/>
  <origin xyz="0 0 ${-(chassis_height/2) - (down_cam_height/2)}"
          rpy="0 ${pi/2} 0"/>
</joint>

<gazebo reference="camera_down_link">
  <sensor type="camera" name="camera_down">
    <update_rate>30.0</update_rate>
    <camera name="head">
      <horizontal_fov>2.094395</horizontal_fov> <!--120 deg-->
      <image>
        <width>800</width>
        <height>800</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.02</near>
        <far>300</far>
      </clip>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.007</stddev>
      </noise>
    </camera>
    <plugin name="camera_down_controller" filename="libgazebo_ros_camera.so">
      <alwaysOn>true</alwaysOn>
      <updateRate>0.0</updateRate>
      <cameraName>rrbot/camera_down</cameraName>
      <imageTopicName>image_raw</imageTopicName>
      <cameraInfoTopicName>camera_info</cameraInfoTopicName>
      <frameName>camera_down_link</frameName>
      <hackBaseline>0.07</hackBaseline>
      <distortionK1>0.0</distortionK1>
      <distortionK2>0.0</distortionK2>
      <distortionK3>0.0</distortionK3>
      <distortionT1>0.0</distortionT1>
      <distortionT2>0.0</distortionT2>
    </plugin>
  </sensor>
</gazebo>

<!-- Legs -->

<!-- Legs drop below chassis by leg_length*cos(tilt), camera needs clearance of down_cam_height -->
<!-- leg_length=0.04 gives ~0.038m clearance at 20deg tilt, comfortably > down_cam_height=0.005m -->

<xacro:macro name="landing_leg" params="name angle">
  <link name="leg_${name}">
    <xacro:cylinder_inertial name="leg_${name}" m="${leg_mass}" r="${leg_radius}" h="${leg_length}"/>
    <collision name="leg_${name}_collision">
      <geometry>
        <cylinder radius="${leg_radius}" length="${leg_length}"/>
      </geometry>
    </collision>
    <visual name="leg_${name}_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${leg_radius}" length="${leg_length}"/>
      </geometry>
    </visual>
  </link>
  <!--
    Place leg at chassis edge (chassis_radius - leg_radius) in XY, at the bottom face in Z.
    rpy tilts the leg outward by 20deg around the axis tangent to the chassis edge,
    so the foot splays out for stability while the top stays at the chassis rim.
    The leg link origin is at its center, so offset by half leg_length downward.
  -->
  <joint name="leg_${name}_joint" type="fixed">
    <parent link="chassis"/>
    <child link="leg_${name}"/>
    <origin xyz="${cos(radians(angle)) * (chassis_radius - leg_radius)}
                 ${sin(radians(angle)) * (chassis_radius - leg_radius)}
                 ${-(chassis_height/2) - (leg_length/2) * cos(0.349)}"
            rpy="${sin(radians(angle)) * 0.349} ${-cos(radians(angle)) * 0.349} 0"/>
  </joint>
</xacro:macro>

<xacro:landing_leg name="front"  angle="0"/>
<xacro:landing_leg name="left"   angle="90"/>
<xacro:landing_leg name="back"   angle="180"/>
<xacro:landing_leg name="right"  angle="270"/>

<!-- Colours! -->
<gazebo reference="camera_link">
  <material>Gazebo/Purple</material>
</gazebo>
<gazebo reference="camera_down_link">
  <material>Gazebo/Purple</material>
</gazebo>
<gazebo reference="leg_front">
  <material>Gazebo/Black</material>
</gazebo>
<gazebo reference="leg_left">
  <material>Gazebo/Black</material>
</gazebo>
<gazebo reference="leg_back">
  <material>Gazebo/Black</material>
</gazebo>
<gazebo reference="leg_right">
  <material>Gazebo/Black</material>
</gazebo>

</robot>