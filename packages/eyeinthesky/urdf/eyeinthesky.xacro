<xacro:macro name="landing_leg" params="name angle">
  <link name="leg_${name}">
    <xacro:cylinder_inertial name="leg_${name}" m="${leg_mass}" r="${leg_radius}" h="${leg_length}"/>
    <collision name="leg_${name}_collision">
      <geometry>
        <cylinder radius="${leg_radius}" length="${leg_length}"/>
      </geometry>
    </collision>
    <visual name="leg_${name}_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${leg_radius}" length="${leg_length}"/>
      </geometry>
    </visual>
  </link>
  <joint name="leg_${name}_joint" type="fixed">
    <parent link="chassis"/>
    <child link="leg_${name}"/>
    <origin xyz="${cos(radians(angle)) * (chassis_radius - leg_radius)}
                 ${sin(radians(angle)) * (chassis_radius - leg_radius)}
                 ${-(chassis_height/2) - (leg_length/2) * cos(0.349)}"
            rpy="${sin(radians(angle)) * 0.349} ${-cos(radians(angle)) * 0.349} 0"/>
  </joint>
</xacro:macro>

<xacro:landing_leg name="front"  angle="0"/>
<xacro:landing_leg name="left"   angle="90"/>
<xacro:landing_leg name="back"   angle="180"/>
<xacro:landing_leg name="right"  angle="270"/>

<gazebo reference="camera_link">
  <material>Gazebo/Purple</material>
</gazebo>
<!-- <gazebo reference="camera_down_link">
  <material>Gazebo/Purple</material>
</gazebo> -->
<gazebo reference="leg_front">
  <material>Gazebo/Black</material>
</gazebo>
<gazebo reference="leg_left">
  <material>Gazebo/Black</material>
</gazebo>
<gazebo reference="leg_back">
  <material>Gazebo/Black</material>
</gazebo>
<gazebo reference="leg_right">
  <material>Gazebo/Black</material>
</gazebo>

</robot>